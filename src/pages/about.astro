---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="About PlatoonX — Our Goal, Vision & Mission" description="Learn about PlatoonX's mission to conduct world-class AI research and build original technologies that address India's scientific, industrial, and societal challenges.">
  <div class="page-header">
    <div class="header-bg"></div>
    <div class="content-wrapper reveal">
      <h1 class="page-title">About PlatoonX</h1>
      <p class="page-subtitle">A research-first organization advancing India's capability in artificial intelligence.</p>
    </div>
  </div>

  <section class="section">
    <div class="content-wrapper">
      <div class="text-block reveal">
        <h2>Who we are</h2>
        <p>PlatoonX is an AI research startup positioned closer to a research institute with startup execution speed. We exist to advance India's AI research capability and technological standing globally. We are not a generic software agency or consumer product company; our focus is on fundamental and applied AI research.</p>
      </div>

      <div class="text-block reveal">
        <h2>Goal</h2>
        <p class="lead">Advance India through world-class AI research, technology, and real-world applications.</p>
        <p>To advance India’s technological capabilities through world-class artificial intelligence research, the creation of original AI technologies, and the translation of scientific discoveries into high-impact real-world applications.</p>
      </div>

      <div class="text-block reveal">
        <h2>Vision</h2>
        <p>To make India a global leader in artificial intelligence research and innovation.</p>
        <p>To establish India as a global leader in artificial intelligence research, innovation, and technological development, contributing original knowledge and AI technologies that address significant challenges across science, industry, and society.</p>
      </div>

      <div class="text-block reveal">
        <h2>Mission</h2>
        <p>To conduct fundamental and applied AI research, create original AI technologies, and translate research into solutions that address India's scientific, industrial, and societal challenges.</p>
        <p>PlatoonX aims to cultivate a research-driven culture that advances the frontiers of AI while strengthening India's capacity to create, own, and deploy globally competitive AI technologies.</p>
      </div>
    </div>
  </section>

  <section class="section bg-cream">
    <div class="content-wrapper reveal">
      <h2>Research Philosophy & Principles</h2>
      <div class="principles-grid">
        <div class="card-feature-light">
          <h3>Scientific Rigor</h3>
          <p>We believe in empirical evidence and reproducibility. Research must be sound, validated, and peer-reviewable.</p>
        </div>
        <div class="card-feature-light">
          <h3>Original Technologies</h3>
          <p>We prioritize fundamental breakthroughs and novel architectures over derivative wrappers.</p>
        </div>
        <div class="card-feature-light">
          <h3>Real-World Impact</h3>
          <p>Our research serves India's scientific, industrial, and societal needs. We aim to solve hard, structural problems.</p>
        </div>
        <div class="card-feature-light">
          <h3>Responsible AI</h3>
          <p>Developing systems that are interpretable, safe, and aligned with human values is core to our engineering process.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="content-wrapper text-center reveal">
      <h2>Our Team</h2>
      <p class="section-body">Team information coming soon.</p>
    </div>
  </section>

  <section class="section cta-band">
    <div class="content-wrapper text-center reveal">
      <h2>Let's build India's AI future together</h2>
      <p class="section-body mb-lg">We are always looking for exceptional researchers, engineers, and partners.</p>
      <Button href="/contact" variant="primary">Get in Touch</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    position: relative;
    padding: 120px var(--space-xl) 80px;
    text-align: center;
    overflow: hidden;
  }
  .header-bg {
    position: absolute;
    top: -50%;
    left: 0;
    right: 0;
    height: 200%;
    background: radial-gradient(circle at 50% 0%, var(--color-canvas-cream) 0%, transparent 60%);
    filter: blur(40px);
    z-index: -1;
    opacity: 0.5;
  }
  .content-wrapper {
    max-width: 800px;
    margin: 0 auto;
  }
  .page-title {
    font: var(--text-display-xxl);
    letter-spacing: var(--tracking-display-xxl);
    color: var(--color-ink);
    margin-bottom: var(--space-md);
  }
  .page-subtitle {
    font: var(--text-heading-md);
    color: var(--color-ink-secondary);
  }
  
  .section {
    padding: var(--space-huge) var(--space-xl);
  }
  .bg-cream {
    background-color: var(--color-canvas-cream);
  }
  
  .text-block {
    margin-bottom: var(--space-huge);
  }
  .text-block h2 {
    font: var(--text-display-lg);
    letter-spacing: var(--tracking-display-lg);
    margin-bottom: var(--space-md);
    color: var(--color-ink);
  }
  .text-block p {
    font: var(--text-body-lg);
    color: var(--color-ink-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-md);
  }
  .text-block .lead {
    font: var(--text-heading-md);
    color: var(--color-ink);
  }
  
  .principles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    margin-top: var(--space-xxl);
  }
  @media (min-width: 768px) {
    .principles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  .card-feature-light {
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    padding: var(--space-xxl);
    box-shadow: var(--shadow-level-1);
  }
  .card-feature-light h3 {
    font: var(--text-heading-lg);
    margin-bottom: var(--space-sm);
  }
  .card-feature-light p {
    font: var(--text-body-md);
    color: var(--color-ink-secondary);
  }
  
  .text-center {
    text-align: center;
  }
  .section-body {
    font: var(--text-body-lg);
    color: var(--color-ink-secondary);
  }
  .mb-lg {
    margin-bottom: var(--space-lg);
  }
  .cta-band {
    padding-top: 120px;
    padding-bottom: 120px;
    background: linear-gradient(to bottom, var(--color-canvas), var(--color-canvas-soft));
  }

  @media (max-width: 767px) {
    .page-title {
      font: var(--text-display-lg);
      letter-spacing: var(--tracking-display-lg);
    }
  }
</style>
