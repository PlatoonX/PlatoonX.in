---
import BaseLayout from '../layouts/BaseLayout.astro';
import GradientMesh from '../components/GradientMesh.astro';
import Button from '../components/Button.astro';
import ResearchAreaCard from '../components/ResearchAreaCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CompositeResearchMockup from '../components/CompositeResearchMockup.astro';
---

<BaseLayout title="PlatoonX — AI Research for India" description="PlatoonX is an AI research startup advancing India through fundamental and applied artificial intelligence research, original AI technologies, and real-world applications.">
  <div class="hero-section">
    <GradientMesh />
    <div class="hero-content">
      <h1 class="hero-title reveal">Advancing India through world-class AI research.</h1>
      <p class="hero-subtitle reveal">To advance India’s technological capabilities through world-class artificial intelligence research, the creation of original AI technologies, and the translation of scientific discoveries into high-impact real-world applications.</p>
      <div class="hero-ctas reveal">
        <Button href="/contact" variant="primary">Collaborate With Us</Button>
        <Button href="/about" variant="secondary">About PlatoonX</Button>
      </div>
    </div>
  </div>

  <section class="section company-intro">
    <div class="section-content reveal">
      <h2 class="section-title">A research-first AI lab</h2>
      <p class="section-body">We conduct fundamental and applied research across artificial intelligence and related fields. Our focus is on developing novel algorithms, models, and intelligent systems, translating research outcomes into practical solutions for India's scientific, industrial, economic, and societal needs.</p>
    </div>
  </section>

  <section class="section research-areas bg-soft">
    <div class="section-content">
      <h2 class="section-title reveal">Where we focus our research</h2>
      <p class="section-intro reveal">Exploring the frontiers of computation and intelligence.</p>
      
      <div class="grid-3">
        <ResearchAreaCard 
          title="Machine Learning" 
          description="Fundamental algorithms and statistical models that enable computers to perform tasks without explicit instructions."
          tags={['Algorithms', 'Optimization']}
        />
        <ResearchAreaCard 
          title="Generative AI" 
          description="Models capable of generating novel text, images, or other media, pushing the boundaries of automated creativity."
          tags={['LLMs', 'Diffusion']}
        />
        <ResearchAreaCard 
          title="Multimodal AI" 
          description="Systems that process and relate information from multiple distinct modalities like text, audio, and vision."
          tags={['Vision-Language', 'Audio']}
        />
      </div>
    </div>
  </section>

  <section class="section current-projects">
    <div class="section-content">
      <h2 class="section-title reveal">Current research & projects</h2>
      <p class="section-intro reveal">Our active initiatives and exploratory models.</p>
      
      <div class="project-mockup-wrapper reveal">
        <CompositeResearchMockup />
      </div>

      <div class="grid-3">
        <ProjectCard 
          name="Project Alpha"
          area="Generative AI"
          status="In Research"
          description="[TO BE PROVIDED]"
          technology="[TO BE PROVIDED]"
          objective="[TO BE PROVIDED]"
        />
        <ProjectCard 
          name="Project Beta"
          area="Multimodal AI"
          status="Early Stage"
          description="[TO BE PROVIDED]"
          technology="[TO BE PROVIDED]"
          objective="[TO BE PROVIDED]"
        />
        <ProjectCard 
          name="Project Gamma"
          area="Scientific AI"
          status="Exploratory"
          description="[TO BE PROVIDED]"
          technology="[TO BE PROVIDED]"
          objective="[TO BE PROVIDED]"
        />
      </div>
    </div>
  </section>

  <section class="section philosophy bg-cream">
    <div class="section-content reveal">
      <div class="card-cream-band">
        <h2 class="section-title">How we do research</h2>
        <ul class="philosophy-list">
          <li><strong>Scientific Rigor:</strong> We prioritize empirical validation and reproducibility over hype.</li>
          <li><strong>Originality:</strong> We aim for fundamental breakthroughs rather than derivative applications.</li>
          <li><strong>Real-world Impact:</strong> Our work must translate into solutions for India's greatest challenges.</li>
          <li><strong>Responsible AI:</strong> We build systems that are safe, interpretable, and aligned with human values.</li>
          <li><strong>Long-term Horizon:</strong> We invest in ambitious research programs that compound over decades.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section vision-mission">
    <div class="section-content reveal text-center">
      <h2 class="section-title">Our goal, vision, and mission</h2>
      <p class="section-body">To make India a global leader in artificial intelligence research and innovation. We aim to cultivate a research-driven culture that advances the frontiers of AI while strengthening India's capacity to create, own, and deploy globally competitive AI technologies.</p>
      <div class="mt-lg">
        <a href="/about" class="link-on-light">Read more &rarr;</a>
      </div>
    </div>
  </section>

  <section class="section cta-band">
    <div class="section-content reveal text-center">
      <h2 class="section-title">Let's build India's AI future together</h2>
      <p class="section-body mb-lg">We are always looking for exceptional researchers, engineers, and partners.</p>
      <Button href="/contact" variant="primary">Get in Touch</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-section {
    position: relative;
    padding: 120px var(--space-xl) 160px;
    display: flex;
    justify-content: center;
    overflow: hidden;
  }
  .hero-content {
    max-width: 800px;
    text-align: center;
    position: relative;
    z-index: 1;
  }
  .hero-title {
    font: var(--text-display-xxl);
    letter-spacing: var(--tracking-display-xxl);
    color: var(--color-ink);
    margin-bottom: var(--space-lg);
  }
  .hero-subtitle {
    font: var(--text-heading-md);
    color: var(--color-ink-secondary);
    margin-bottom: var(--space-xxl);
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }
  .hero-ctas {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
  }
  
  .section {
    padding: var(--space-huge) var(--space-xl);
  }
  .section-content {
    max-width: 1200px;
    margin: 0 auto;
  }
  .bg-soft {
    background-color: var(--color-canvas-soft);
  }
  .bg-cream {
    background-color: var(--color-canvas-cream);
  }
  .section-title {
    font: var(--text-display-xl);
    letter-spacing: var(--tracking-display-xl);
    margin-bottom: var(--space-md);
  }
  .section-intro {
    font: var(--text-heading-md);
    color: var(--color-ink-secondary);
    margin-bottom: var(--space-xxl);
  }
  .section-body {
    font: var(--text-body-lg);
    color: var(--color-ink-secondary);
    max-width: 800px;
    line-height: 1.6;
  }
  
  .grid-3 {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }
  @media (min-width: 768px) {
    .grid-3 {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .grid-3 {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .project-mockup-wrapper {
    margin-bottom: var(--space-huge);
    max-width: 1000px;
    margin-left: auto;
    margin-right: auto;
  }

  .card-cream-band {
    background-color: var(--color-canvas-cream);
    padding: var(--space-xxl);
    border-radius: var(--radius-lg);
  }
  .philosophy-list {
    margin-top: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .philosophy-list li {
    font: var(--text-body-md);
    position: relative;
    padding-left: var(--space-xl);
  }
  .philosophy-list li::before {
    content: '•';
    color: var(--color-primary);
    position: absolute;
    left: 0;
    font-size: 1.2em;
    line-height: 1;
  }

  .text-center {
    text-align: center;
  }
  .text-center .section-body {
    margin-left: auto;
    margin-right: auto;
  }
  .mt-lg {
    margin-top: var(--space-lg);
  }
  .mb-lg {
    margin-bottom: var(--space-lg);
  }
  .cta-band {
    padding-top: 120px;
    padding-bottom: 120px;
    background: linear-gradient(to bottom, var(--color-canvas), var(--color-canvas-soft));
  }

  @media (max-width: 767px) {
    .hero-title {
      font: var(--text-display-lg);
      letter-spacing: var(--tracking-display-lg);
    }
    .section-title {
      font: var(--text-display-lg);
      letter-spacing: var(--tracking-display-lg);
    }
    .hero-ctas {
      flex-direction: column;
    }
  }
</style>
