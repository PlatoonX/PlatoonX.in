---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Contact PlatoonX — Research & Partnership Enquiries" description="Reach PlatoonX for research collaboration, academic partnerships, industry collaboration, or career enquiries.">
  <div class="page-header">
    <div class="header-bg"></div>
    <div class="content-wrapper reveal">
      <h1 class="page-title">Contact Us</h1>
      <p class="page-subtitle">Route your enquiry to the right team.</p>
    </div>
  </div>

  <section class="section">
    <div class="content-wrapper">
      <div class="contact-grid">
        <div class="card-feature-light reveal">
          <h3>Research Collaboration</h3>
          <p>For researchers, universities, and research organizations exploring academic partnerships.</p>
          <div class="card-action">
            <Button href="mailto:research@platoonx.in" variant="primary">Email Research</Button>
          </div>
        </div>

        <div class="card-feature-light reveal">
          <h3>Industry Partnerships</h3>
          <p>For organizations and enterprises seeking AI collaboration and technology translation.</p>
          <div class="card-action">
            <Button href="mailto:partnerships@platoonx.in" variant="primary">Email Partnerships</Button>
          </div>
        </div>

        <div class="card-feature-light reveal">
          <h3>Careers</h3>
          <p>For researchers, engineers, and interns looking to join our mission.</p>
          <div class="card-action">
            <Button href="mailto:careers@platoonx.in" variant="secondary">View Careers</Button>
          </div>
        </div>

        <div class="card-feature-light reveal">
          <h3>General Enquiries</h3>
          <p>For all other questions, media enquiries, or general information.</p>
          <div class="card-action">
            <Button href="mailto:hello@platoonx.in" variant="secondary">Say Hello</Button>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    position: relative;
    padding: 120px var(--space-xl) 80px;
    text-align: center;
    overflow: hidden;
  }
  .header-bg {
    position: absolute;
    top: -50%;
    left: 0;
    right: 0;
    height: 200%;
    background: radial-gradient(circle at 50% 0%, var(--color-primary-bg-subdued-hover) 0%, transparent 60%);
    filter: blur(40px);
    z-index: -1;
    opacity: 0.3;
  }
  .content-wrapper {
    max-width: 1000px;
    margin: 0 auto;
  }
  .page-title {
    font: var(--text-display-xxl);
    letter-spacing: var(--tracking-display-xxl);
    color: var(--color-ink);
    margin-bottom: var(--space-md);
  }
  .page-subtitle {
    font: var(--text-heading-md);
    color: var(--color-ink-secondary);
  }
  
  .section {
    padding: var(--space-huge) var(--space-xl) 120px;
  }
  
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }
  @media (min-width: 768px) {
    .contact-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  .card-feature-light {
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    padding: var(--space-xxl);
    display: flex;
    flex-direction: column;
    transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
  }
  .card-feature-light:hover, .card-feature-light:focus-within {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-level-1);
    transform: translateY(-2px);
  }
  .card-feature-light h3 {
    font: var(--text-heading-lg);
    margin-bottom: var(--space-sm);
    color: var(--color-ink);
  }
  .card-feature-light p {
    font: var(--text-body-md);
    color: var(--color-ink-secondary);
    margin-bottom: var(--space-xl);
    flex-grow: 1;
  }
  .card-action {
    margin-top: auto;
  }

  @media (max-width: 767px) {
    .page-title {
      font: var(--text-display-lg);
      letter-spacing: var(--tracking-display-lg);
    }
  }
</style>
