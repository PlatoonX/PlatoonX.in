---
---
<footer class="footer-light">
  <div class="footer-content">
    <div class="footer-col brand">
      <img src="/BGR - PlatoonX - black.png" alt="PlatoonX Logo" height="32" class="footer-logo" />
      <p>Advancing India through world-class AI research.</p>
    </div>
    <div class="footer-col">
      <span class="col-title">Navigation</span>
      <a href="/">Home</a>
      <a href="/about">About Us</a>
      <a href="/contact">Contact</a>
    </div>
    <div class="footer-col">
      <span class="col-title">Research</span>
      <span class="coming-soon">Research areas (Coming soon)</span>
      <span class="coming-soon">Projects (Coming soon)</span>
      <span class="coming-soon">Publications (Coming soon)</span>
    </div>
    <div class="footer-col">
      <span class="col-title">Contact</span>
      <a href="mailto:research@platoonx.in">Research</a>
      <a href="mailto:partnerships@platoonx.in">Partnerships</a>
      <a href="mailto:careers@platoonx.in">Careers</a>
      <a href="mailto:hello@platoonx.in">General</a>
    </div>
  </div>
  <div class="footer-bottom">
    <p>&copy; {new Date().getFullYear()} PlatoonX. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer-light {
    background-color: var(--color-canvas);
    color: var(--color-ink-mute);
    font: var(--text-caption);
    padding: var(--space-huge) var(--space-xl);
    border-top: 1px solid var(--color-hairline);
  }
  .footer-content {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .col-title {
    font: var(--text-micro-cap);
    text-transform: uppercase;
    color: var(--color-ink);
    margin-bottom: var(--space-xs);
  }
  .footer-col a {
    color: var(--color-ink-mute);
    transition: color 0.2s;
  }
  .footer-col a:hover, .footer-col a:focus-visible {
    color: var(--color-primary);
    outline-color: var(--color-primary);
  }
  .footer-logo {
    margin-bottom: var(--space-md);
  }
  .brand p {
    max-width: 250px;
    line-height: 1.5;
  }
  .coming-soon {
    color: var(--color-hairline-input);
  }
  .footer-bottom {
    max-width: 1200px;
    margin: var(--space-huge) auto 0;
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-hairline);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  @media (min-width: 768px) {
    .footer-content {
      grid-template-columns: 2fr 1fr 1fr 1fr;
    }
  }
</style>
