---
<div class="mesh-container">
  <div class="mesh-bg"></div>
</div>

<style>
  .mesh-container {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 800px;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background-color: var(--color-canvas);
  }
  .mesh-bg {
    position: absolute;
    top: -20%;
    left: -10%;
    width: 120%;
    height: 100%;
    background: 
      radial-gradient(circle at 15% 50%, var(--color-canvas-cream) 0%, transparent 40%),
      radial-gradient(circle at 35% 40%, var(--color-lemon) 0%, transparent 40%),
      radial-gradient(circle at 60% 30%, var(--color-primary-bg-subdued-hover) 0%, transparent 40%),
      radial-gradient(circle at 80% 50%, var(--color-primary) 0%, transparent 40%),
      radial-gradient(circle at 90% 70%, var(--color-ruby) 0%, transparent 40%),
      radial-gradient(circle at 50% 60%, var(--color-magenta) 0%, transparent 40%);
    filter: blur(80px);
    opacity: 0.15;
    animation: drift 20s infinite alternate ease-in-out;
  }
  
  @keyframes drift {
    0% { transform: scale(1) translate(0, 0); }
    100% { transform: scale(1.05) translate(-2%, 2%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .mesh-bg {
      animation: none;
    }
  }
</style>
