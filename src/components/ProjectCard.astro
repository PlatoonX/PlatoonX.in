---
interface Props {
  name: string;
  description: string;
  area: string;
  status: string;
  technology: string;
  objective: string;
  link?: string;
}

const { name, description, area, status, technology, objective, link } = Astro.props;
---
<div class="card-project reveal">
  <div class="card-header">
    <div>
      <h3 class="card-title">{name}</h3>
      <span class="card-area">{area}</span>
    </div>
    <span class="pill-tag-soft status">{status}</span>
  </div>
  <p class="card-description">{description}</p>
  
  <div class="card-details">
    <div class="detail-row">
      <span class="detail-label">Technology</span>
      <span class="detail-value">{technology}</span>
    </div>
    <div class="detail-row">
      <span class="detail-label">Objective</span>
      <span class="detail-value">{objective}</span>
    </div>
  </div>

  <div class="card-footer">
    {link ? (
      <a href={link} class="link-on-light">Learn more &rarr;</a>
    ) : (
      <span class="link-on-light disabled">Details coming soon</span>
    )}
  </div>
</div>

<style>
  .card-project {
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    padding: var(--space-xxl);
    transition: box-shadow 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  .card-project:hover {
    box-shadow: var(--shadow-level-1);
    transform: translateY(-2px);
  }
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--space-md);
  }
  .card-title {
    font: var(--text-heading-lg);
    color: var(--color-ink);
  }
  .card-area {
    font: var(--text-micro);
    color: var(--color-ink-mute);
    display: block;
    margin-top: var(--space-xs);
  }
  .pill-tag-soft {
    background-color: var(--color-primary-bg-subdued-hover);
    color: var(--color-primary-deep);
    font: var(--text-micro-cap);
    padding: 4px 8px;
    border-radius: var(--radius-pill);
    text-transform: uppercase;
  }
  .status {
    background-color: var(--color-canvas-soft);
    color: var(--color-ink-secondary);
    border: 1px solid var(--color-hairline);
  }
  .card-description {
    font: var(--text-body-md);
    color: var(--color-ink-secondary);
    margin-bottom: var(--space-xl);
  }
  .card-details {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
    border-top: 1px solid var(--color-hairline);
    padding-top: var(--space-lg);
  }
  .detail-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-xxs);
  }
  .detail-label {
    font: var(--text-micro);
    color: var(--color-ink-mute);
    text-transform: uppercase;
  }
  .detail-value {
    font: var(--text-body-md);
    color: var(--color-ink);
  }
  .card-footer {
    margin-top: auto;
  }
  .link-on-light {
    font: var(--text-body-md);
    color: var(--color-primary);
    position: relative;
    padding-bottom: 2px;
  }
  .link-on-light:not(.disabled):hover, .link-on-light:not(.disabled):focus-visible {
    text-decoration: underline;
  }
  .link-on-light.disabled {
    color: var(--color-ink-mute);
    cursor: not-allowed;
  }
</style>
