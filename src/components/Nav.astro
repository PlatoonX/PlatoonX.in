---
---
<header class="nav-wrapper">
  <nav class="nav-bar">
    <div class="logo">
      <a href="/">
        <img src="/BGR-PlatoonX - main.png" alt="PlatoonX" height="24" />
      </a>
    </div>
    <ul class="nav-links">
      <li><a href="/">Home</a></li>
      <li><a href="/about">About Us</a></li>
      <li><a href="/contact">Contact</a></li>
    </ul>
    <div class="nav-cta">
      <a href="/contact" class="button-primary-pill">Collaborate With Us</a>
    </div>
    <button class="mobile-menu-toggle" aria-label="Toggle menu" aria-expanded="false">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path class="line-1" d="M3 12h18" />
        <path class="line-2" d="M3 6h18" />
        <path class="line-3" d="M3 18h18" />
      </svg>
    </button>
  </nav>
  <div class="mobile-menu">
    <ul>
      <li><a href="/">Home</a></li>
      <li><a href="/about">About Us</a></li>
      <li><a href="/contact">Contact</a></li>
      <li><a href="/contact" class="button-primary-pill">Collaborate With Us</a></li>
    </ul>
  </div>
</header>

<style>
  .nav-wrapper {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: transparent;
    transition: background-color 0.3s ease, border-color 0.3s ease;
    border-bottom: 1px solid transparent;
  }
  .nav-wrapper.scrolled {
    background-color: var(--color-canvas);
    border-bottom: 1px solid var(--color-hairline);
  }
  .nav-bar {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-lg) var(--space-xl);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav-links {
    display: none;
    gap: var(--space-xl);
    align-items: center;
  }
  .nav-links a {
    font: var(--text-body-md);
    color: var(--color-ink);
    position: relative;
    padding-bottom: 2px;
  }
  .nav-links a:hover::after, .nav-links a:focus::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background-color: var(--color-primary);
    animation: underline 0.2s ease forwards;
  }
  @keyframes underline {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }
  .button-primary-pill {
    display: inline-flex;
    align-items: center;
    background-color: var(--color-primary);
    color: var(--color-on-primary);
    font: var(--text-button-md);
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    transition: background-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .button-primary-pill:hover, .button-primary-pill:focus-visible {
    background-color: var(--color-primary-deep);
    transform: translateY(-2px);
    box-shadow: var(--shadow-level-1);
    outline: 2px solid var(--color-primary-soft);
    outline-offset: 2px;
  }
  .button-primary-pill:active {
    background-color: var(--color-primary-press);
    transform: translateY(0);
  }
  .nav-cta {
    display: none;
  }
  .mobile-menu-toggle {
    display: block;
    color: var(--color-ink);
    z-index: 101;
  }
  .mobile-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background-color: var(--color-canvas);
    padding: var(--space-xl);
    border-bottom: 1px solid var(--color-hairline);
    box-shadow: var(--shadow-level-2);
  }
  .mobile-menu.is-open {
    display: block;
  }
  .mobile-menu ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }
  .mobile-menu a:not(.button-primary-pill) {
    font: var(--text-heading-md);
    display: block;
    padding: var(--space-sm) 0;
  }
  .mobile-menu .button-primary-pill {
    justify-content: center;
    margin-top: var(--space-md);
  }

  @media (min-width: 1024px) {
    .nav-links, .nav-cta {
      display: flex;
    }
    .mobile-menu-toggle {
      display: none;
    }
    .mobile-menu {
      display: none !important;
    }
  }
</style>

<script>
  const wrapper = document.querySelector('.nav-wrapper');
  const toggle = document.querySelector('.mobile-menu-toggle');
  const menu = document.querySelector('.mobile-menu');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      wrapper?.classList.add('scrolled');
    } else {
      wrapper?.classList.remove('scrolled');
    }
  });

  toggle?.addEventListener('click', () => {
    const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', (!isExpanded).toString());
    menu?.classList.toggle('is-open');
    if (!isExpanded) {
      wrapper?.classList.add('scrolled');
    } else if (window.scrollY <= 20) {
      wrapper?.classList.remove('scrolled');
    }
  });
</script>
